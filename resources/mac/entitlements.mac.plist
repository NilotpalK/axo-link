<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lifted from OpenWhispr's resources/mac/entitlements.mac.plist (MIT),
     minus its calendar key.

     Deliberately NOT sandboxed: this app's whole job is spawning the `claude`
     CLI as a child process, which com.apple.security.app-sandbox forbids. That
     also rules out the Mac App Store, which is fine -- it is a developer tool. -->
<plist version="1.0">
<dict>
    <!-- Required for Electron apps -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for Electron's V8 JavaScript engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow loading Electron Framework signed by a different Team ID -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Microphone, for answering an agent by voice -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
