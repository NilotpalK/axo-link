# Copy to .env (never committed) and fill in. Values here win over the PC's
# own environment variables; blank ones are ignored.

# Gemini key for voice, dictation, clean-up and reading out. Only the PC that
# runs the hub needs it.
GEMINI_API_KEY=

# Optional, for several machines (see README):
# AXO_TOKEN=     shared secret every app connecting to the hub needs
# AXO_HOST=      0.0.0.0 to open the hub to the network (needs AXO_TOKEN)
# AXO_HUB=       ws://home-pc:7777 on the machines that don't run the hub
# AXO_DEVICE=    the name this machine shows in the pill
