{
  "name": "axo-link",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on-top pill that tells you when an agent is waiting on you.",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "node -e \"const fs=require('fs'),d='node_modules/node-pty/prebuilds';try{for(const p of fs.readdirSync(d))if(fs.existsSync(d+'/'+p+'/spawn-helper'))fs.chmodSync(d+'/'+p+'/spawn-helper',0o755)}catch{}\""
  },
  "devDependencies": {
    "electron": "^44.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "bin": {
    "axo": "cli/axo.js"
  }
}
